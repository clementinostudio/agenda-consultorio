{
  "name": "agenda-consultorio",
  "private": true,
  "version": "1.0.0",
  "description": "Avina: agenda, cobranças e contas para profissionais da saúde mental. PWA feito com Vite + React.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "dev:site": "vite --config vite.site.config.js --host",
    "build:site": "vite build --config vite.site.config.js",
    "publicar:site": "npm run build:site && cd site && npx wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "6.4.299",
    "pluggy-connect-sdk": "^2.14.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
