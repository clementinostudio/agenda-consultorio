{
  // Configuração do servidor de avisos (Cloudflare Workers)
  "name": "agenda-avisos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Workers AI: transcreve a fala do app (Whisper) e entende frases e fotos, dentro da cota grátis da Cloudflare
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  // Endereços do app (só eles podem usar a fala e a IA; separados por vírgula) e contato dos avisos.
  // O github.io fica enquanto houver app instalado no endereço antigo.
  "vars": { "ORIGEM": "https://app.avina.com.br,https://clementinostudio.github.io", "VAPID_SUB": "https://avina.com.br/" },
  "kv_namespaces": [{ "binding": "AVISOS", "id": "9f010db2187d4adf8a567f0c41cf2a9f" }]
}
