{
  "expo": {
    "name": "Avina",
    "slug": "avina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "avina",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0C11",
    "ios": {
      "bundleIdentifier": "br.com.avina.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "O Avina usa a câmera para ler o QR code da nota fiscal, o código de barras do boleto e tirar foto de recibos.",
        "NSMicrophoneUsageDescription": "O Avina usa o microfone quando você fala com a Bolinha, por exemplo para anotar um gasto falando.",
        "NSPhotoLibraryUsageDescription": "O Avina usa as suas fotos quando você escolhe uma foto de nota, de comprovante ou de perfil.",
        "NSPhotoLibraryAddUsageDescription": "O Avina salva nas suas fotos as imagens que você pedir para guardar, como o QR code de um convite."
      }
    },
    "android": {
      "package": "br.com.avina.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0C11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Avina usa a sua localização só enquanto você usa o app, para achar o posto e o mercado mais baratos perto de você.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Avina usa o Face ID para proteger a sua agenda, os seus pacientes e o seu dinheiro."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1F3BEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
