{
  // Configuração do servidor de avisos (Cloudflare Workers)
  "name": "agenda-avisos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Workers AI: transcreve a fala do app (Whisper) e entende frases e fotos, dentro da cota grátis da Cloudflare
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  // Endereços do app (só eles podem usar a fala e a IA; separados por vírgula) e contato dos avisos.
  // O github.io fica enquanto houver app instalado no endereço antigo.
  "vars": { "ORIGEM": "https://app.avina.com.br,https://clementinostudio.github.io", "VAPID_SUB": "https://avina.com.br/",
    // Assinatura (src/asaas.js): login do app (o Supabase confere quem é) e o Asaas (sandbox = testes; produção: https://api.asaas.com/v3).
    // A chave do Asaas NÃO fica aqui: vai como segredo (npx wrangler secret put ASAAS_KEY).
    "SUPABASE_URL": "https://dtuykxvsmkfjpogbskcx.supabase.co", "SUPABASE_KEY": "sb_publishable_FLZO5Ajriib4ZrDl8zXj2g_DPBPc3uH",
    "ASAAS_URL": "https://api.asaas.com/v3",
    // Dia em que a cobrança de verdade começou (o ligar-asaas.sh producao preenche). Contas mais antigas ganham 30 dias de Pro.
    "COBRANCA_INICIO": "2026-10-28",
    // Painel do dono (src/admin.js): números da Cloudflare. O token NÃO fica aqui: vai como segredo CF_API_TOKEN (ligar-cloudflare-painel.sh).
    "CF_ACCOUNT_ID": "44dd13e1f157411e2f8e7c3ba92daf48", "KV_ID": "9f010db2187d4adf8a567f0c41cf2a9f", "CF_ZONA": "avina.com.br" },
  "kv_namespaces": [{ "binding": "AVISOS", "id": "9f010db2187d4adf8a567f0c41cf2a9f" }]
}
